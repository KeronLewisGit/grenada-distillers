APP_NAME="Clarke's Court"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.clarkescourtrum.com
APP_TIMEZONE=America/Antigua
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_gdl
DB_USERNAME=u000000000_gdl
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@clarkescourtrum.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@clarkescourtrum.com
MAIL_FROM_NAME="${APP_NAME}"

# Company details shown on the site (confirm with the client).
# true on the temporary preview domain: banner + noindex. Remove at launch.
GDL_PREVIEW=false
# Public telephone. Leave empty to hide the Call buttons until the distillery confirms a number.
GDL_PHONE="473-444-5363"
# WhatsApp Business number. Leave empty to hide WhatsApp.
GDL_WHATSAPP=
GDL_EMAIL=assistsect@clarkescourtrum.com
# Who gets "new request" emails, comma separated (e.g. the tours, export and HR inboxes).
GDL_NOTIFY_EMAIL=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
